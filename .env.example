# Required.
# Base URL of the Better Auth backend / API server.
EXPO_PUBLIC_API_URL=https://api.example.com

# Not needed in the normal flow from docs/auth.md.
# Web uses browser cookies automatically.
# Native auth also does NOT need Origin by default.
#
# Only set these for native apps if your backend explicitly requires an
# Origin header from Expo/React Native requests, and that Origin has already
# been whitelisted in BETTER_AUTH_TRUSTED_ORIGINS or API_ALLOWED_ORIGINS.
#
# Example optional native-only setup:
# EXPO_PUBLIC_AUTH_INCLUDE_ORIGIN=true
# EXPO_PUBLIC_AUTH_ORIGIN=https://app.example.com
